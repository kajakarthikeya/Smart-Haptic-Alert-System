# ==============================================================================
# Smart Haptic Alert System - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# System Settings
APP_NAME="Smart Haptic Alert System"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Context & Operating Mode
# Options: HOME, ROAD, OFFICE
INITIAL_MODE="HOME"

# Audio Capture & Feature Extraction
SAMPLE_RATE=16000
AUDIO_CHANNELS=1
FRAME_DURATION_SEC=1.0
N_FFT=512
HOP_LENGTH=160
N_MELS=64

# Bluetooth LE (ESP32 Wearable Device)
BLE_DEVICE_NAME="ESP32-Haptic-Alert"
BLE_DEVICE_MAC="00:11:22:33:44:55"
BLE_ALERT_SERVICE_UUID="0000180a-0000-1000-8000-00805f9b34fb"
BLE_ALERT_CHAR_UUID="00002a29-0000-1000-8000-00805f9b34fb"
BLE_RECONNECT_ATTEMPTS=5

# API Server Configuration
API_HOST="127.0.0.1"
API_PORT=8000
API_WORKERS=1

# Output & Artifact Paths
MODEL_PATH="app/outputs/sound_classifier.tflite"
LOG_DIR="app/logs"
